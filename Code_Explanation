#include <stdint.h>        // เรียกใช้ชนิดข้อมูลจำนวนเต็ม เช่น uint8_t และ uint32_t

#include <stdbool.h>    // เรียกใช้ชนิดข้อมูล Boolean คือ true และ false

#include <stdlib.h>      // เรียกใช้ฟังก์ชัน rand() และ srand() สำหรับสุ่มตัวเลข


volatile uint32_t msTicks = 0;   // ตัวแปรเก็บเวลาหน่วยมิลลิวินาที โดย volatile ป้องกัน Compiler ใช้ค่าเก่าที่เก็บไว้


void SysTick_Handler(void) {    // ฟังก์ชัน Interrupt Service Routine ทำงานเมื่อเกิด SysTick Interrupt

    msTicks++;     // เพิ่มค่าเวลาขึ้น 1 ทุกครั้งที่เกิด Interrupt (ทุก 1 มิลลิวินาที)

}                                 // จบฟังก์ชัน SysTick_Handler


void delay_ms(uint32_t ms) {         // ฟังก์ชันหน่วงเวลาตามจำนวนมิลลิวินาทีที่รับเข้ามา

    uint32_t start = msTicks;        // เก็บค่าเวลาปัจจุบันไว้ในตัวแปร start เพื่อใช้เป็นจุดเริ่มต้น

    while ((msTicks - start) < ms);  // วนรอจนกว่าเวลาที่ผ่านไปจะครบตามจำนวน ms ที่กำหนด

}                                    // จบฟังก์ชัน delay_ms


void delay_short(void) {             // ฟังก์ชันหน่วงเวลาสั้น ๆ ใช้ควบคุมจังหวะการส่งข้อมูล

    for (volatile int i = 0; i < 60; i++); // วนลูป 60 รอบเพื่อสร้างเวลาหน่วงสั้น ๆ

}                                    // จบฟังก์ชัน delay_short


// Common Anode 7-Segment codes (0-9) and digit select (left -> right)
// ตารางรหัสสำหรับ 7-Segment แบบ Common Anode และการเลือกตำแหน่งหลักจากซ้ายไปขวา

const uint8_t segDigits[10] = { 0xC0, 0xF9, 0xA4, 0xB0, 0x99, 0x92, 0x82, 0xF8, 0x80, 0x90 };
// อาร์เรย์เก็บรหัสสำหรับแสดงตัวเลข 0-9 บน 7-Segment โดยแต่ละค่าเป็นเลขฐาน 16

const uint8_t segSelect[4]  = { 0xF1, 0xF2, 0xF4, 0xF8 };
// อาร์เรย์เก็บรหัสเลือกตำแหน่งแสดงผลทั้ง 4 หลัก เรียงจากซ้ายไปขวา

uint8_t displayBuf[4]       = { 0x8C, 0xC7, 0x88, 0x91 }; // อาร์เรย์เก็บข้อมูลที่ต้องการแสดงบนจอ 4 หลัก เริ่มต้นแสดงคำว่า PLAY


const char keymap[4][3] = {           // สร้างอาร์เรย์ 2 มิติ สำหรับกำหนดตำแหน่งปุ่มของ Keypad 4 แถว 3 คอลัมน์

    {'1', '2', '3'},                 // แถวที่ 1 มีปุ่ม 1, 2 และ 3

    {'4', '5', '6'},                 // แถวที่ 2 มีปุ่ม 4, 5 และ 6

    {'7', '8', '9'},                 // แถวที่ 3 มีปุ่ม 7, 8 และ 9

    {'*', '0', '#'}                  // แถวที่ 4 มีปุ่ม *, 0 และ #

};                                   // จบการกำหนดตำแหน่งปุ่ม Keypad


// Fix 5V PNP Buzzer on 3.3V K64F: Use High-Z Input for OFF, Output LOW for ON
// ควบคุม Buzzer วงจรทรานซิสเตอร์ PNP 5V โดยใช้ High-Z เพื่อปิด และ Output LOW เพื่อเปิด


void buzzerOff(void) {               // ฟังก์ชันปิดเสียง Buzzer

    PTA->PDDR &= ~(1U << 1);         // กำหนด PTA1 เป็น Input หรือ High-Z เพื่อตัดกระแสควบคุมฐานทรานซิสเตอร์ PNP

}                                    // จบฟังก์ชัน buzzerOff


void buzzerOn(void) {                // ฟังก์ชันเปิดเสียง Buzzer

    PTA->PCOR = (1U << 1);           // กำหนด Output Latch ของ PTA1 ให้เป็น LOW

    PTA->PDDR |= (1U << 1);          // กำหนด PTA1 เป็น Output ทำให้ขาออกเป็น LOW และเปิดวงจร Buzzer

}                                    // จบฟังก์ชัน buzzerOn


void initHardware(void) {            // ฟังก์ชันเริ่มต้นและตั้งค่าขาอุปกรณ์ฮาร์ดแวร์ทั้งหมด

    // Enable Clock for PORT A, B, C, D
    // เปิด Clock ให้กับ PORT A, B, C และ D เพื่อให้สามารถใช้งาน GPIO ได้

    SIM->SCGC5 |= SIM_SCGC5_PORTA_MASK | SIM_SCGC5_PORTB_MASK |
                  SIM_SCGC5_PORTC_MASK | SIM_SCGC5_PORTD_MASK;
    // เปิดใช้งาน Clock ของ PORT A, PORT B, PORT C และ PORT D


    // 1. 7-Segment Display (74HC595): Latch=PTB23(D4), CLK=PTC3(D7), DATA=PTC12(D8)
    // กำหนดขาสำหรับควบคุม 7-Segment ผ่าน IC 74HC595

    PORTB->PCR[23] = PORT_PCR_MUX(1); // ตั้งค่า PTB23 เป็น GPIO ใช้ควบคุมขา Latch

    PORTC->PCR[3]  = PORT_PCR_MUX(1); // ตั้งค่า PTC3 เป็น GPIO ใช้ควบคุมขา Clock

    PORTC->PCR[12] = PORT_PCR_MUX(1); // ตั้งค่า PTC12 เป็น GPIO ใช้ส่งข้อมูล Data

    PTB->PDDR |= (1U << 23);          // กำหนด PTB23 เป็น Output สำหรับส่งสัญญาณ Latch

    PTC->PDDR |= (1U << 3) | (1U << 12); // กำหนด PTC3 และ PTC12 เป็น Output


    // 2. 4 LEDs (Lives): D1=PTD1, D2=PTD3, D3=PTD2, D4=PTD0
    // กำหนดขาสำหรับ LED 4 ดวง ใช้แสดงจำนวนชีวิตของผู้เล่น

    PORTD->PCR[0] = PORT_PCR_MUX(1); // ตั้งค่า PTD0 เป็น GPIO

    PORTD->PCR[1] = PORT_PCR_MUX(1); // ตั้งค่า PTD1 เป็น GPIO

    PORTD->PCR[2] = PORT_PCR_MUX(1); // ตั้งค่า PTD2 เป็น GPIO

    PORTD->PCR[3] = PORT_PCR_MUX(1); // ตั้งค่า PTD3 เป็น GPIO

    PTD->PDDR |= (1U << 0) | (1U << 1) | (1U << 2) | (1U << 3);
    // กำหนดขา PTD0, PTD1, PTD2 และ PTD3 เป็น Output เพื่อควบคุม LED


    // 3. Buzzer = PTA1(D3) -> GPIO mode, no pull resistors, High-Z (OFF)
    // กำหนด PTA1 เป็น GPIO เพื่อควบคุม Buzzer โดยเริ่มต้นในสถานะปิด

    PORTA->PCR[1] = PORT_PCR_MUX(1); // ตั้งค่า PTA1 เป็น GPIO

    buzzerOff();                     // เรียกฟังก์ชันปิด Buzzer เพื่อให้เริ่มต้นด้วยสถานะ OFF


    // 4. Difficulty Switches: S1=PTB3(A1), S2=PTB10(A2), S3=PTB11(A3)
    // กำหนดขา Switch 3 ตัว สำหรับเลือกระดับความยากของเกม

    PORTB->PCR[3]  = PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    // ตั้งค่า PTB3 เป็น GPIO และเปิดใช้งาน Pull-up Resistor สำหรับ Switch S1

    PORTB->PCR[10] = PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    // ตั้งค่า PTB10 เป็น GPIO และเปิดใช้งาน Pull-up Resistor สำหรับ Switch S2

    PORTB->PCR[11] = PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    // ตั้งค่า PTB11 เป็น GPIO และเปิดใช้งาน Pull-up Resistor สำหรับ Switch S3

    PTB->PDDR &= ~((1U << 3) | (1U << 10) | (1U << 11));
    // กำหนด PTB3, PTB10 และ PTB11 เป็น Input เพื่อรับสถานะจาก Switch


    // 5. Keypad Rows (Output): R1=PTA2(~5), R2=PTC2(~6), R3=PTC4(~9), R4=PTC10(A5)
    // กำหนดขา Row ทั้ง 4 แถวของ Keypad เป็น Output

    PORTA->PCR[2]  = PORT_PCR_MUX(1); // ตั้งค่า PTA2 เป็น GPIO สำหรับ Row 1

    PORTC->PCR[2]  = PORT_PCR_MUX(1); // ตั้งค่า PTC2 เป็น GPIO สำหรับ Row 2

    PORTC->PCR[4]  = PORT_PCR_MUX(1); // ตั้งค่า PTC4 เป็น GPIO สำหรับ Row 3

    PORTC->PCR[10] = PORT_PCR_MUX(1); // ตั้งค่า PTC10 เป็น GPIO สำหรับ Row 4

    PTA->PDDR |= (1U << 2);            // กำหนด PTA2 เป็น Output

    PTC->PDDR |= (1U << 2) | (1U << 4) | (1U << 10);
    // กำหนด PTC2, PTC4 และ PTC10 เป็น Output


    // 6. Keypad Columns (Input + Pull-Up): C1=PTC11(A4), C2=PTB9(D2), C3=PTC17(D1)
    // กำหนดขา Column ทั้ง 3 คอลัมน์เป็น Input และเปิด Pull-up Resistor

    PORTC->PCR[11] = PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    // ตั้งค่า PTC11 เป็น GPIO และเปิด Pull-up Resistor สำหรับ Column 1

    PORTB->PCR[9]  = PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    // ตั้งค่า PTB9 เป็น GPIO และเปิด Pull-up Resistor สำหรับ Column 2

    PORTC->PCR[17] = PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    // ตั้งค่า PTC17 เป็น GPIO และเปิด Pull-up Resistor สำหรับ Column 3

    PTC->PDDR &= ~((1U << 11) | (1U << 17));
    // กำหนด PTC11 และ PTC17 เป็น Input

    PTB->PDDR &= ~(1U << 9);          // กำหนด PTB9 เป็น Input

}                                    // จบฟังก์ชัน initHardware


void shiftOutByte(uint8_t val) {      // ฟังก์ชันส่งข้อมูล 8 บิตไปยัง IC 74HC595

    for (int i = 0; i < 8; i++) {     // วนลูปทั้งหมด 8 รอบ เพื่อส่งข้อมูลทีละบิต

        if (val & (0x80 >> i)) {       // ตรวจสอบบิตของข้อมูล โดยเริ่มจากบิตที่มีค่าสูงสุด (MSB)

            PTC->PSOR = (1U << 12);  // กำหนด PTC12 เป็น HIGH เพื่อส่งข้อมูลบิต 1

        } else {                     // หากบิตที่ตรวจสอบมีค่าเป็น 0

            PTC->PCOR = (1U << 12);  // กำหนด PTC12 เป็น LOW เพื่อส่งข้อมูลบิต 0

        }                            // จบเงื่อนไขตรวจสอบบิต

        PTC->PSOR = (1U << 3);        // กำหนด PTC3 เป็น HIGH เพื่อสร้างสัญญาณ Clock

        delay_short();               // หน่วงเวลาสั้น ๆ เพื่อให้ IC รับข้อมูลได้ทัน

        PTC->PCOR = (1U << 3);        // กำหนด PTC3 เป็น LOW เพื่อจบจังหวะ Clock

    }                                // จบการวนส่งข้อมูลครบ 8 บิต

}                                    // จบฟังก์ชัน shiftOutByte


void refreshDisplay(void) {           // ฟังก์ชันอัปเดตการแสดงผลบน 7-Segment ทั้ง 4 หลัก

    for (int d = 0; d < 4; d++) {     // วนลูปเลือกตำแหน่งจอแสดงผลตั้งแต่หลักที่ 0 ถึง 3

        PTB->PCOR = (1U << 23);       // กำหนด PTB23 เป็น LOW เพื่อเริ่มส่งข้อมูลผ่าน Latch

        shiftOutByte(displayBuf[d]);  // ส่งรหัส Segment ของตัวเลขหรือตัวอักษรที่ต้องการแสดง

        shiftOutByte(segSelect[d]);   // ส่งรหัสเลือกตำแหน่งหลักของ 7-Segment

        PTB->PSOR = (1U << 23);       // กำหนด PTB23 เป็น HIGH เพื่อ Latch ข้อมูลไปยังเอาต์พุต

        delay_ms(2);                 // หน่วงเวลา 2 มิลลิวินาที ก่อนเปลี่ยนไปแสดงหลักถัดไป

    }                                // จบการวนแสดงผลครบทั้ง 4 หลัก

}                                    // จบฟังก์ชัน refreshDisplay


void waitWithDisplay(uint32_t durationMs) { // ฟังก์ชันหน่วงเวลาพร้อมรักษาการแสดงผลของจอ 7-Segment

    for (uint32_t t = 0; t < durationMs; t += 8) {
        // วนลูปโดยเพิ่มตัวนับครั้งละ 8 จนถึงเวลาที่กำหนด

        refreshDisplay();            // เรียกอัปเดตจอ 7-Segment ระหว่างการรอ

    }                                // จบการวนลูปหน่วงเวลา

}                                    // จบฟังก์ชัน waitWithDisplay


void updateLives(int lives) {         // ฟังก์ชันอัปเดตไฟ LED ตามจำนวนชีวิตที่เหลือ

    if (lives >= 1) PTD->PCOR = (1U << 1); else PTD->PSOR = (1U << 1); // D1: มีชีวิตอย่างน้อย 1 ให้ติด ไม่เช่นนั้นดับ

    if (lives >= 2) PTD->PCOR = (1U << 3); else PTD->PSOR = (1U << 3); // D2: มีชีวิตอย่างน้อย 2 ให้ติด ไม่เช่นนั้นดับ

    if (lives >= 3) PTD->PCOR = (1U << 2); else PTD->PSOR = (1U << 2); // D3: มีชีวิตอย่างน้อย 3 ให้ติด ไม่เช่นนั้นดับ

    if (lives >= 4) PTD->PCOR = (1U << 0); else PTD->PSOR = (1U << 0); // D4: มีชีวิตครบ 4 ให้ติด ไม่เช่นนั้นดับ

}                                    // จบฟังก์ชัน updateLives


void beep(uint32_t durationMs) {      // ฟังก์ชันสร้างเสียง Buzzer ตามระยะเวลาที่กำหนด

    buzzerOn();                      // เปิด Buzzer ให้เกิดเสียง

    waitWithDisplay(durationMs);     // รอเวลาตามที่กำหนด พร้อมอัปเดตจอ 7-Segment

    buzzerOff();                     // ปิด Buzzer เมื่อครบเวลาที่กำหนด

}                                    // จบฟังก์ชัน beep


void setAllRowsHigh(void) {           // ฟังก์ชันกำหนดให้ขา Row ของ Keypad ทุกแถวเป็น HIGH

    PTA->PSOR = (1U << 2);            // กำหนด PTA2 เป็น HIGH สำหรับ Row 1

    PTC->PSOR = (1U << 2) | (1U << 4) | (1U << 10);
    // กำหนด PTC2, PTC4 และ PTC10 เป็น HIGH สำหรับ Row 2, 3 และ 4

}                                    // จบฟังก์ชัน setAllRowsHigh


void setRowLow(int r) {               // ฟังก์ชันเลือกแถวของ Keypad โดยกำหนดแถวที่ต้องการเป็น LOW

    setAllRowsHigh();                // ตั้งค่า Row ทุกแถวเป็น HIGH ก่อนเลือกแถวใหม่

    if (r == 0) PTA->PCOR = (1U << 2); // ถ้า r เท่ากับ 0 ให้ Row 1 เป็น LOW

    else if (r == 1) PTC->PCOR = (1U << 2); // ถ้า r เท่ากับ 1 ให้ Row 2 เป็น LOW

    else if (r == 2) PTC->PCOR = (1U << 4); // ถ้า r เท่ากับ 2 ให้ Row 3 เป็น LOW

    else if (r == 3) PTC->PCOR = (1U << 10); // ถ้า r เท่ากับ 3 ให้ Row 4 เป็น LOW

}                                    // จบฟังก์ชัน setRowLow


bool isColLow(int c) {                // ฟังก์ชันตรวจสอบว่าคอลัมน์ของ Keypad มีสถานะเป็น LOW หรือไม่

    if (c == 0) return (PTC->PDIR & (1U << 11)) == 0; // ตรวจสอบ Column 1 ที่ PTC11 ถ้าเป็น LOW ให้คืนค่า true

    if (c == 1) return (PTB->PDIR & (1U << 9))  == 0; // ตรวจสอบ Column 2 ที่ PTB9 ถ้าเป็น LOW ให้คืนค่า true

    if (c == 2) return (PTC->PDIR & (1U << 17)) == 0; // ตรวจสอบ Column 3 ที่ PTC17 ถ้าเป็น LOW ให้คืนค่า true

    return false;                    // ถ้าไม่ใช่คอลัมน์ 0, 1 หรือ 2 ให้คืนค่า false

}                                    // จบฟังก์ชัน isColLow


char scanKeypad(void) {               // ฟังก์ชันสแกน Keypad เพื่ออ่านปุ่มที่ผู้เล่นกด

    for (int r = 0; r < 4; r++) {     // วนตรวจสอบแถวของ Keypad ตั้งแต่แถวที่ 0 ถึง 3

        setRowLow(r);                // กำหนดแถวปัจจุบันให้เป็น LOW เพื่อใช้ตรวจจับปุ่ม

        delay_short();               // หน่วงเวลาสั้น ๆ เพื่อให้สถานะสัญญาณคงที่ก่อนอ่านค่า

        for (int c = 0; c < 3; c++) { // วนตรวจสอบคอลัมน์ตั้งแต่คอลัมน์ที่ 0 ถึง 2

            if (isColLow(c)) {       // ตรวจสอบว่าคอลัมน์ปัจจุบันมีสถานะ LOW หรือไม่

                delay_ms(12);        // หน่วงเวลา 12 มิลลิวินาทีเพื่อป้องกันสัญญาณเด้ง (Debounce)

                if (isColLow(c)) {   // ตรวจสอบสถานะคอลัมน์ซ้ำอีกครั้งหลังหน่วงเวลา

                    setAllRowsHigh(); // ตั้งค่า Row ทุกแถวเป็น HIGH ก่อนส่งค่าปุ่มกลับ

                    return keymap[r][c]; // คืนค่าปุ่มที่ตรงกับตำแหน่งแถวและคอลัมน์ที่ตรวจพบ

                }                    // จบเงื่อนไขตรวจสอบปุ่มซ้ำ

            }                        // จบเงื่อนไขตรวจพบคอลัมน์ LOW

        }                            // จบการตรวจสอบคอลัมน์

    }                                // จบการตรวจสอบแถวทั้งหมด

    setAllRowsHigh();                // หากไม่พบปุ่ม ให้ตั้งค่า Row ทุกแถวเป็น HIGH

    return '\0';                     // คืนค่าอักขระว่าง เพื่อบอกว่าไม่มีการกดปุ่ม

}                                    // จบฟังก์ชัน scanKeypad


int readDifficultySwitch(void) {      // ฟังก์ชันอ่านสถานะ Switch เพื่อเลือกระดับความยากของเกม

    if ((PTB->PDIR & (1U << 3))  == 0) return 1; // ถ้า PTB3 เป็น LOW แสดงว่ากด S1 ให้คืนค่า 1

    if ((PTB->PDIR & (1U << 10)) == 0) return 2; // ถ้า PTB10 เป็น LOW แสดงว่ากด S2 ให้คืนค่า 2

    if ((PTB->PDIR & (1U << 11)) == 0) return 3; // ถ้า PTB11 เป็น LOW แสดงว่ากด S3 ให้คืนค่า 3

    return 0;                        // ถ้าไม่มี Switch ตัวใดถูกกด ให้คืนค่า 0

}                                    // จบฟังก์ชัน readDifficultySwitch


// Countdown 1 -> 2 -> 3 with buzzer beep ONLY here
