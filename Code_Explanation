        displayBuf[0] = 0xFF;         // ปิดการแสดงผลหลักที่ 1

        displayBuf[1] = segDigits[count]; // แสดงตัวเลขนับถอยหลังที่หลักที่ 2

        displayBuf[2] = 0xFF;         // ปิดการแสดงผลหลักที่ 3

        displayBuf[3] = 0xFF;         // ปิดการแสดงผลหลักที่ 4

        beep(70);                    // เปิดเสียง Buzzer เป็นเวลา 70 มิลลิวินาที

        waitWithDisplay(630);        // รออีก 630 มิลลิวินาที พร้อมอัปเดตจอแสดงผล

    }                                // จบการนับถอยหลังครบ 3 รอบ

    buzzerOff();                     // ตรวจสอบให้แน่ใจว่า Buzzer อยู่ในสถานะปิด

    for (int i = 0; i < 4; i++) displayBuf[i] = 0xFF;
    // วนลูปปิดการแสดงผลทั้ง 4 หลัก โดยกำหนดรหัส 0xFF

    waitWithDisplay(150);            // เว้นช่วง 150 มิลลิวินาทีก่อนเริ่มเกม

