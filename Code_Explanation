            // วนลูปปิดการแสดงผลของ 7-Segment ทั้ง 4 หลัก

            waitWithDisplay(250);                          // รอ 250 มิลลิวินาที ก่อนเริ่มรอบใหม่

        }                                                  // จบลูปเล่นเกมเมื่อชีวิตเหลือ 0


        // 4. Game Over: Alternate between Score ("SCxx") and High Score ("HIxx")
        // หน้าจอ Game Over สลับแสดงคะแนนปัจจุบันและคะแนนสูงสุด

        int toggleTimer = 0;                               // ตัวแปรนับเวลาสำหรับสลับหน้าจอแสดงคะแนน

        bool showHigh = false;                             // ตัวแปรกำหนดว่าจะแสดงคะแนนปัจจุบันหรือคะแนนสูงสุด โดยเริ่มจากคะแนนปัจจุบัน


        while (readDifficultySwitch() == 0) {              // วนแสดงหน้า Game Over จนกว่าจะมีการกด Switch

            if (!showHigh) {                               // หาก showHigh เป็น false ให้แสดงคะแนนปัจจุบัน

                displayBuf[0] = 0x92;                      // แสดงตัวอักษร S ที่หลักที่ 1

                displayBuf[1] = 0xC6;                      // แสดงตัวอักษร C ที่หลักที่ 2

                displayBuf[2] = segDigits[(score / 10) % 10];
                // แสดงเลขหลักสิบของคะแนนปัจจุบัน

                displayBuf[3] = segDigits[score % 10];
                // แสดงเลขหลักหน่วยของคะแนนปัจจุบัน

            } else {                                       // หาก showHigh เป็น true ให้แสดงคะแนนสูงสุด

                displayBuf[0] = 0x89;                      // แสดงตัวอักษร H ที่หลักที่ 1

                displayBuf[1] = 0xF9;                      // แสดงตัวอักษร I ที่หลักที่ 2

                displayBuf[2] = segDigits[(highScore / 10) % 10];
                // แสดงเลขหลักสิบของคะแนนสูงสุด

                displayBuf[3] = segDigits[highScore % 10];
                // แสดงเลขหลักหน่วยของคะแนนสูงสุด

            }                                              // จบเงื่อนไขการเลือกหน้าจอคะแนน


            refreshDisplay();                              // อัปเดตจอ 7-Segment ให้แสดงผลตามข้อมูลปัจจุบัน

            toggleTimer += 8;                              // เพิ่มตัวนับเวลาสำหรับสลับหน้าจอครั้งละ 8 หน่วย

            if (toggleTimer >= 1200) {                     // ตรวจสอบว่าตัวนับเวลาถึง 1,200 แล้วหรือไม่

                toggleTimer = 0;                           // รีเซ็ตตัวนับเวลากลับเป็น 0

                showHigh = !showHigh;                      // สลับสถานะระหว่างแสดงคะแนนปัจจุบันกับคะแนนสูงสุด

            }                                              // จบการตรวจสอบเวลาสลับหน้าจอ

        }                                                  // จบลูปหน้า Game Over เมื่อมีการกด Switch


        // Wait until switch released before returning to PLAY
        // รอจนกว่าผู้เล่นจะปล่อย Switch ก่อนกลับไปหน้าเริ่มต้น

        while (readDifficultySwitch() != 0) {               // วนรอในขณะที่ยังมี Switch ถูกกดอยู่

            refreshDisplay();                              // อัปเดตจอแสดงผลระหว่างรอให้ปล่อย Switch

        }                                                  // จบลูปรอการปล่อย Switch


    }                                                      // จบลูปหลักของเกม แต่ while(1) จะทำให้เริ่มต้นใหม่ได้ตลอด

}                                                          // จบฟังก์ชัน main
